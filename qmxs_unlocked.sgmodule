#!name=七猫小说

#!desc=七猫小说解锁

#!icon=https://raw.githubusercontent.com/deezertidal/private/main/icons/qmxs.png

#!homepage=https://yfamilys.com

#!author=I-am-R-E

[Rule]
DOMAIN,cdn-ad.wtzw.com,REJECT
DOMAIN,cdn-new-ad.wtzw.com,REJECT
DOMAIN-SUFFIX,gdt.qq.com,REJECT

[Url Rewrite]
# 开屏广告
^https?:\/\/api-cfg\.wtzw\.com\/v1\/splash\/ reject-dict

#add 000
^https?:\/\/\w\d+-be-pack(-sign)?\.pglstatp-toutiao\.com\/.+ reject-dict
^https?:\/\/sf3-fe-tos\.pglstatp-toutiao\.com\/.+ reject-dict
^https?:\/\/api-access\.pangolin-sdk-toutiao(-?\w+)?\.com\/.+ reject-dict

#add 001
^https?:\/\/pgdt\.ugdtimg\.com\/.+ reject-dict
^https?:\/\/.*myqcloud.com\/.+ reject-dict

# 腾格尔打卡喵喵歌
^https?:\/\/api-bc\.wtzw\.com\/api\/v4\/search\/dispose reject-dict
# 必读榜弹窗
^https?:\/\/api-bc\.wtzw\.com\/api\/v1\/book-store\/config reject-dict
# 推荐书籍弹窗
^https?:\/\/api-bc\.wtzw\.com\/api\/v1\/book-store\/push-book reject-dict
# 有声阅读界面广告横幅
^https?:\/\/api-bc\.wtzw\.com\/api\/v1\/operation reject-dict
# 头条广告SDK
^https?:\/\/sf3-fe-tos\.pglstatp-toutiao\.com\/obj\/ad-pattern\/ reject
# 听书赚金币
^https?:\/\/api-gw\.wtzw\.com\/welf\/app\/v1\/task\/red-packet reject-dict
# 正文底部推广
^https?:\/\/cdn\.wtzw\.com\/bookimg\/free\/api\/v1\/reader\/reader-copy-paragraph-all\.json reject-dict
# 其他广告
^https?:\/\/api-cfg\.wtzw\.com\/v1\/reward\/ reject
^https?:\/\/api-cfg\.wtzw\.com\/v1\/adv\/ reject
^https?:\/\/api-cfg\.wtzw\.com\/v1\/offline-adv\/index reject-dict
^https?:\/\/api-cfg\.wtzw\.com\/v1\/operation\/index\?ad_personal_switch reject-dict

[MITM]
hostname = %APPEND% api-cfg.wtzw.com,xiaoshuo.wtzw.com,sf3-fe-tos.pglstatp-toutiao.com,api-bc.wtzw.com,api-gw.wtzw.com,cdn.wtzw.com
#*.wtzw.com



[Script]
七猫小说=type=http-response,pattern=^https?:\/\/(api-\w+|xiaoshuo)\.wtzw\.com\/api\/v\d\/,requires-body=1,script-path=https://raw.githubusercontent.com/I-am-R-E/QuantumultX/main/JavaScript/QiMaoXiaoShuo.js
