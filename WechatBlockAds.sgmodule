[Rule]
DOMAIN-SUFFIX,wxs.qq.com,REJECT,extended-matching,pre-matching

[URL Rewrite]
^https:\/\/mp\.weixin\.qq\.com\/mp\/(cps_product_info|getappmsgad|jsmonitor|masonryfeed|relatedarticle)\? - reject-200

^https:\/\/mp\.weixin\.qq\.com\/mp\/relatedsearchword - reject-200

[MITM]
hostname = %APPEND% mp.weixin.qq.com
